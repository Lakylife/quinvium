# Caddy configuration of the public quinvium.com server. Adapt the domain names for your own node.

# Behind Cloudflare (orange cloud): every request then reaches Caddy from a Cloudflare address, and without the block
# below Caddy passes that address to the node in X-Forwarded-For. The node (--trust-proxy) takes the last
# X-Forwarded-For entry as the caller, so all visitors would share one rate limit per Cloudflare edge address.
# For host names that are proxied by Cloudflare, uncomment the global block and add
#     header_up X-Forwarded-For {client_ip}
# inside each of their reverse_proxy directives, for example:
#     reverse_proxy 127.0.0.1:8545 {
#         header_up X-Forwarded-For {client_ip}
#     }
# {client_ip} is the visitor's address from Cf-Connecting-Ip, and only when the request came from a range listed
# in trusted_proxies; from anywhere else it is the connecting address, so nobody can forge it by sending the header.
# Also allow ports 80 and 443 in the firewall only from these ranges (see docs/RUNNING-A-PUBLIC-NODE.md), so the
# origin cannot be reached around Cloudflare. Leave all of this commented out for names that are "DNS only".
# Cloudflare's published ranges (https://www.cloudflare.com/ips-v4 and /ips-v6) as of 24 November 2026; check them
# again when you enable this, Cloudflare announces changes there.
#
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# 		client_ip_headers Cf-Connecting-Ip
# 	}
# }

# Website (packages/website/public, built by packages/website/src/build.mjs)
quinvium.com {
	encode zstd gzip
	# release downloads (ops/deploy-downloads.sh)
	handle_path /downloads/* {
		root * /var/www/quinvium-downloads
		header Content-Disposition attachment
		header Cache-Control "public, max-age=31536000, immutable"
		header /*SHA256SUMS.txt Cache-Control "public, max-age=300"
		file_server
	}
	root * /var/www/quinvium
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
	header {
		Content-Security-Policy "default-src 'self'; connect-src https://rpc.quinvium.com; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
}

www.quinvium.com {
	redir https://quinvium.com{uri} permanent
}

# Mainnet: Explorer and JSON-RPC (service quinvium-mainnet)
explorer.quinvium.com {
	encode zstd gzip
	# robots.txt and sitemap.xml for search engines come straight from the Explorer files
	@seo path /robots.txt /sitemap.xml
	handle @seo {
		root * /opt/quinvium/packages/explorer/public
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8545
	}
}

# JSON-RPC only: nothing to index
rpc.quinvium.com {
	encode zstd gzip
	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8545
	}
}

# Testnet: Explorer and JSON-RPC (service quinvium-testnet)
testnet.quinvium.com, rpc1.quinvium.com {
	encode zstd gzip
	# the testnet would only duplicate the mainnet Explorer in search results
	header X-Robots-Tag "noindex"
	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8546
	}
}

# Mining pool server (service quinvium-pool, docs/POOLS.md): JSON-RPC for miners. Stratum listens on port 4444 directly.
pool.quinvium.com {
	encode zstd gzip
	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8555
	}
}
