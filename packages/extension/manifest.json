{
  "manifest_version": 3,
  "name": "Quinvium Wallet",
  "version": "2.14.2",
  "description": "Peněženka sítě Quinvium: klíče zůstávají jen u vás, každý podpis schvalujete vy.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Quinvium Wallet" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["inpage.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
