 "<span>Wrapped QU (WQU)</span><code>0xae0000000000000000000000000000000000000a</code>": "<span>Wrapped QU（WQU）</span><code>0xae0000000000000000000000000000000000000a</code>",
 "<span>Multicall</span><code>0xae0000000000000000000000000000000000000b</code>": "<span>Multicall</span><code>0xae0000000000000000000000000000000000000b</code>",
 "<span>Pool factory</span><code>0xae0000000000000000000000000000000000000c</code>": "<span>矿池工厂</span><code>0xae0000000000000000000000000000000000000c</code>",
