# Keys for the Quinvium announcer. Copy to /etc/quinvium/announcer.env, fill in, then: chmod 600 /etc/quinvium/announcer.env
# Never commit the filled-in file. A channel without keys stays in dry-run mode.

# Telegram: create a bot with @BotFather, add it as an administrator of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT=@Quinvium

# Optional community gatekeeper (see README): the Bot API id of the private "Quinvium Community" group.
# Join requests get the rules in a private message and are approved after the button is pressed. Leave empty to turn it off.
COMMUNITY_CHAT_ID=

# X: an app on developer.x.com (Free tier) with "Read and Write" permission; keys of the @Quinvium account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
