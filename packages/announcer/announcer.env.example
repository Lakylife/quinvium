# Keys for the Quinvium announcer. Copy to /etc/quinvium/announcer.env, fill in, then: chmod 600 /etc/quinvium/announcer.env
# Never commit the filled-in file. A channel without keys stays in dry-run mode.

# Telegram: create a bot with @BotFather, add it as an administrator of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT=@Quinvium

# Optional community gatekeeper (see README): the Bot API id of the private "Quinvium Community" group.
# Join requests get the rules in a private message and are approved after the button is pressed. Leave empty to turn it off.
COMMUNITY_CHAT_ID=
# With COMMUNITY_CHAT_ID set, all Telegram posts go to the group's topics and the channel above gets nothing.
# Set TELEGRAM_ANNOUNCE_TO=channel to post to TELEGRAM_CHAT again instead.
# TELEGRAM_ANNOUNCE_TO=
# Topics are linked by an admin with /topic <key> inside each topic. Optional fixed links instead: key=message_thread_id
# COMMUNITY_TOPICS=announcements=2,nodes=3,mining=4,general=5

# X: an app on developer.x.com (Free tier) with "Read and Write" permission; keys of the @Quinvium account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional community assistant (see README): answers questions to @quinviumbot with Claude Haiku 5.5.
# Create a key at console.anthropic.com and set a monthly spend limit there. Leave empty to turn it off.
ANTHROPIC_API_KEY=
# ASSISTANT_DAILY_LIMIT=150
# Auto-answers to QU questions nobody addressed to the bot (on by default):
# ASSISTANT_AUTO=on
